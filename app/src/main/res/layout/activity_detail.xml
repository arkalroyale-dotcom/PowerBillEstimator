<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Details -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/detail_header" />

            <LinearLayout style="@style/ResultRow">
                <TextView style="@style/RowLabel" android:text="@string/res_month" />
                <TextView android:id="@+id/tvDetailMonth" style="@style/RowValue" />
            </LinearLayout>

            <LinearLayout style="@style/ResultRow">
                <TextView style="@style/RowLabel" android:text="@string/res_units" />
                <TextView android:id="@+id/tvDetailUnits" style="@style/RowValue" />
            </LinearLayout>

            <LinearLayout style="@style/ResultRow">
                <TextView style="@style/RowLabel" android:text="@string/res_total" />
                <TextView android:id="@+id/tvDetailTotal" style="@style/RowValue" />
            </LinearLayout>

            <LinearLayout style="@style/ResultRow">
                <TextView style="@style/RowLabel" android:text="@string/res_rebate" />
                <TextView
                    android:id="@+id/tvDetailRebate"
                    style="@style/RowValue"
                    android:textColor="@color/success" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                style="@style/ResultRow"
                android:gravity="center_vertical">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/res_final"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailFinal"
                    style="@style/RowValue"
                    android:textColor="@color/primary"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Edit / Delete buttons -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEdit"
                style="@style/ButtonPrimary"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_edit" />

            <Button
                android:id="@+id/btnDelete"
                style="@style/ButtonDanger"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_delete" />
        </LinearLayout>

        <!-- Edit form (hidden until Edit is tapped) -->
        <LinearLayout
            android:id="@+id/editCard"
            style="@style/CardBox"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/edit_title" />

            <TextView
                style="@style/HelperText"
                android:layout_marginTop="0dp"
                android:text="@string/edit_hint" />

            <TextView
                style="@style/Label"
                android:text="@string/label_month" />

            <Spinner
                android:id="@+id/spEditMonth"
                style="@style/SpinnerField" />

            <TextView
                style="@style/Label"
                android:text="@string/label_units" />

            <EditText
                android:id="@+id/etEditUnits"
                style="@style/InputField"
                android:hint="@string/hint_units"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                style="@style/HelperText"
                android:text="@string/helper_units" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/label_rebate" />

                <TextView
                    android:id="@+id/tvEditRebateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbEditRebate"
                style="@style/RebateSeekBar" />

            <Button
                android:id="@+id/btnSaveChanges"
                style="@style/ButtonPrimary"
                android:layout_marginTop="18dp"
                android:text="@string/btn_save_changes" />

            <Button
                android:id="@+id/btnCancelEdit"
                style="@style/ButtonSecondary"
                android:layout_marginTop="10dp"
                android:text="@string/btn_cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
