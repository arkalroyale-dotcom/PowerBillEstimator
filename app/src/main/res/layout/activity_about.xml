<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- University (logo + name + date) -->
        <LinearLayout
            style="@style/CardBox"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/cd_logo_qiu"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_qiu" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/cd_logo_uitm"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_uitm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/university_name"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/submission_date"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Student information -->
        <LinearLayout
            style="@style/CardBox"
            android:gravity="center_horizontal">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/student_info_title" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/cd_student_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/student_photo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/student_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/student_id"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/course_code"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/course_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- About the app -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/about_app_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/about_app_desc" />

            <TextView
                style="@style/HelperText"
                android:layout_marginTop="8dp"
                android:text="@string/app_version" />
        </LinearLayout>

        <!-- Website (clickable URL) -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/website_title" />

            <TextView
                android:id="@+id/tvGithubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="@string/github_url"
                android:textColorLink="@color/primary_light"
                android:textSize="15sp" />

            <TextView
                style="@style/HelperText"
                android:text="@string/website_hint" />

            <Button
                android:id="@+id/btnOpenWebsite"
                style="@style/ButtonPrimary"
                android:layout_marginTop="12dp"
                android:text="@string/btn_open_website" />
        </LinearLayout>

        <!-- Detailed instructions -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/instructions_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/instructions_full" />
        </LinearLayout>

        <!-- Copyright -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/copyright"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
